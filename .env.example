# Copy to .env.local and fill in. Never commit real values.

# MongoDB Atlas (Mumbai region)
MONGODB_URI=

# Instrument samples (CDN folder with A2.mp3, C3.mp3, Ds3.mp3, Fs3.mp3 ...). Unset = built-in synth.
NEXT_PUBLIC_SAMPLES_URL=

# Better Auth (Phase 3)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay (Phase 4)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
