# Copy to .env.local and fill in. Never commit real values.

# MongoDB Atlas (Mumbai region)
MONGODB_URI=

# Instrument samples (CDN folder with A2.mp3, C3.mp3, Ds3.mp3, Fs3.mp3 ...). Unset = built-in synth.
NEXT_PUBLIC_SAMPLES_URL=

# Better Auth. Secret: `openssl rand -base64 32`. Google sign-in appears only when both Google values are set.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay. Create one monthly and one yearly plan in the dashboard and paste their ids here:
# the prices shown in the app are read from these plans.
# Webhook URL: https://<your-domain>/api/v1/billing/webhook, with all subscription.* events enabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=

# Paddle: the merchant of record for learners outside India (USD). In Paddle: create one product with a monthly and a
# yearly price and paste the price ids (pri_…); create an API key (prices read, subscriptions write) and a client-side
# token (test_… in sandbox, live_… in production); add a notification destination for subscription.* events at
# https://<your-domain>/api/v1/billing/paddle-webhook and paste its secret key. PADDLE_ENV=sandbox until you go live.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_YEARLY=

# Launch settings. All optional: each feature stays off until its value is set.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Error reporting (Sentry): the same DSN in both.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Analytics (Plausible): your site's domain, e.g. fretkey.app
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
